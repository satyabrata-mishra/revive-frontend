# --- Dependencies (install via npm ci in CI / production) ---
node_modules/

# --- Build outputs (generate with npm run build) ---
dist/
dist-ssr/
build/
.vite/

# --- Environment & secrets (use .env.example as template) ---
.env
.env.*
!.env.example

# Vite local env overrides
*.local

# --- Logs & debug ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- TypeScript / tooling cache ---
*.tsbuildinfo
.eslintcache
.cache/
coverage/
.nyc_output/

# --- OS files ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Editor / IDE (local only) ---
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Optional local notes / scratch (not needed to build or deploy) ---
*.md.local
TODO.md
NOTES.md
